# OpenRouter LLM Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Classification Threshold (Inclusive >= 0.80 accepts 1-10; < 0.80 falls back to Miscellaneous)
CONFIDENCE_THRESHOLD=0.80
CLASSIFIER_CONFIDENCE_THRESHOLD=0.80

# Concurrency & Batch Processing Settings (Tuned for High Throughput)
MAX_CONCURRENT_LLM_CALLS=50

# Database Configuration (SQLite default; can be postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///data/domains.db

# Layer 1 HTTP Metadata Enrichment Settings
ENRICHMENT_TIMEOUT_SECONDS=4.0
ENRICHMENT_MAX_RESPONSE_BYTES=524288
ENRICHMENT_MAX_REDIRECTS=3
ENRICHMENT_USER_AGENT=DomainCategorizationBot/1.0 (+https://internal.service)
ENRICHMENT_RESPECT_ROBOTS_TXT=false

# Brand Overrides File
BRAND_OVERRIDES_PATH=data/brand_overrides.json
